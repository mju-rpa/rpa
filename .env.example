# 기본: API 없이 데모 (발표·UiPath 연동)
LLM_PROVIDER=mock

# --- 본인 PC에 Ollama 있을 때만 ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# --- Google AI Studio 무료 키 (https://aistudio.google.com/apikey) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here

# --- OpenAI / Groq / LM Studio 등 (Chat Completions 호환) ---
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Groq 예: OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
