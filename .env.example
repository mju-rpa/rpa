# === LLM (Agentic AI) ===
LLM_PROVIDER=mock

# === Render Web Service (render.com 대시보드 > Web Service) ===
# RENDER 서비스 공개 URL — 예: https://atlas-medical-xxxx.onrender.com
RENDER_SERVICE_URL=RENDER 서비스 URL 입력

# 로컬 PC에서 돌릴 때 위 Render로 로그 전송 (true/false)
RENDER_LOG_FORWARD_ENABLED=false

# /log/ingest 보호용 키 (팀 공유 시크릿, Render Environment에도 동일 값 등록)
RENDER_LOG_INGEST_KEY=RENDER 로그 수집용 시크릿 입력

# === GitHub Actions → Render Logs API pull (.github/workflows/fetch-log.yml) ===
# render.com 계정 Settings 또는 API — Owner ID
RENDER_OWNER_ID=RENDER Owner ID 입력
# Web Service > Settings > Service ID
RENDER_SERVICE_ID=RENDER Service ID 입력
# Account Settings > API Keys
RENDER_API_KEY=RENDER API Key 입력

# === OCR (consult/ocr) — Google AI Studio ===
# GEMINI_API_KEY=GEMINI API Key 입력

# === STT (consult/stt) ===
# TRANSCRIBER_TYPE=local|openai|clova|remote

LOG_LEVEL=INFO
