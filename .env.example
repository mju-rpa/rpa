# 앱 실행 (로컬·Render 공통) — cp .env.example .env 후 값 입력
LLM_PROVIDER=mock
LOG_LEVEL=INFO

# 로컬 PC 실행 시 Render Logs 한곳에 모으기 (팀 시연, dev_doc/logging-render.md)
# Render Environment에도 RENDER_LOG_INGEST_KEY 동일 값 등록
RENDER_SERVICE_URL=https://mju-rpa.onrender.com
RENDER_LOG_FORWARD_ENABLED=true
RENDER_LOG_INGEST_KEY=팀에서_정한_공유_비밀문자열
